# Copy to services/farm-service/.env (loaded by `npm run dev`).
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/agrioptima

# Must equal JWT_SECRET of the FastAPI backend (it issues the tokens).
JWT_SECRET=dev-only-insecure-secret-change-me
CORS_ORIGINS=http://localhost:3000
AGRI_API_URL=http://localhost:8000/api

# Optional: field photo uploads (credentials from the standard AWS chain)
AWS_REGION=ap-south-1
# S3_BUCKET=agrioptima-photos
# S3_PUBLIC_BASE_URL=https://dxxxxxxxx.cloudfront.net
