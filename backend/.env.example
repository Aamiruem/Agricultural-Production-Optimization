# Copy to backend/.env for local development.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./agrioptima.db
# DATABASE_URL=postgresql+psycopg://agri:agri@localhost:5432/agrioptima

# Must match services/farm-service JWT_SECRET. Use 32+ random chars in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
CORS_ORIGINS=http://localhost:3000

# Background jobs: leave unset to run tasks inline; set to use a Celery worker.
# REDIS_URL=redis://localhost:6379/0

# AI assistant (Claude). Without a key the assistant answers from the knowledge base only.
# ANTHROPIC_API_KEY=sk-ant-...
ASSISTANT_LLM=auto
ANTHROPIC_MODEL=claude-opus-5-5
# QDRANT_URL=http://localhost:6333
EMBEDDINGS=auto
