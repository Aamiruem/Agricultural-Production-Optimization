# Optional overrides for the API (started by `python main.py` at the repo root, or
# `uvicorn app.main:app` here). The SQLite database always lives in this folder.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./agrioptima.db
# DATABASE_URL=postgresql+psycopg://agri:agri@localhost:5432/agrioptima

# Must match backend/node-express JWT_SECRET. Use 32+ random chars in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8080

# Background jobs: leave unset to run tasks inline; set to use a Celery worker.
# REDIS_URL=redis://localhost:6379/0

# AI assistant (Claude). Without a key the assistant answers from the knowledge base only.
# ANTHROPIC_API_KEY=sk-ant-...
ASSISTANT_LLM=auto
ANTHROPIC_MODEL=claude-opus-5-5
# QDRANT_URL=http://localhost:6333
EMBEDDINGS=auto

# Local agriculture intelligence (/api/location, /api/weather, /api/soil, /api/agriculture)
# Identify the app to OpenStreetMap Nominatim (required by its usage policy):
NOMINATIM_USER_AGENT=AgriSmart/1.0 (+https://agrismart-two-iota.vercel.app)
# Free key from https://data.gov.in/ for AGMARKNET mandi prices (optional):
# DATA_GOV_IN_API_KEY=
