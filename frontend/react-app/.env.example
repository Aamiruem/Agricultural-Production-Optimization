# Copy to .env.local if you need to change anything. Defaults work with the dev proxy.

# Where the browser sends requests. Relative paths go through the Vite proxy
# (development) or Nginx (Docker). Use absolute URLs to call services directly.
VITE_API_URL=/api
VITE_FARM_API_URL=/farm-api
# Optional account-owned integrations (configure in Vercel Project Settings > Environment Variables)
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_SITE_VERIFICATION=
# VITE_FARM_SOCKET_URL=http://localhost:4000   (defaults to this site's origin)

# Dev-proxy targets (read by vite.config.js)
API_PROXY_TARGET=http://localhost:8000
FARM_PROXY_TARGET=http://localhost:4000
