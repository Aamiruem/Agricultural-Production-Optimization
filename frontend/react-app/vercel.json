{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/recommend", "destination": "/crop-recommendation", "permanent": true },
    { "source": "/yield", "destination": "/yield-prediction", "permanent": true },
    { "source": "/soil", "destination": "/soil-analysis", "permanent": true },
    { "source": "/irrigation", "destination": "/irrigation-optimization", "permanent": true },
    { "source": "/disease", "destination": "/disease-detection", "permanent": true },
    { "source": "/agriculture", "destination": "/agricultural-production-systems", "permanent": true },
    { "source": "/machines", "destination": "/smart-agricultural-machines", "permanent": true },
    { "source": "/ai-solutions", "destination": "/ai-in-agriculture", "permanent": true },
    { "source": "/healthcare", "destination": "/farmer-health", "permanent": true },
    { "source": "/nutrition", "destination": "/food-and-nutrition", "permanent": true },
    { "source": "/login", "destination": "/", "permanent": true },
    { "source": "/register", "destination": "/", "permanent": true },
    { "source": "/admin", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(images|og|icons)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(self)" }
      ]
    }
  ]
}
