# Copy to .env.local and adjust. NEXT_PUBLIC_* values are baked in at build time.

# FastAPI (ML, auth, history, assistant) — used by the browser
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Node farm-service (farms, fields, activities, photos) and its Socket.IO origin
NEXT_PUBLIC_FARM_API_URL=http://localhost:4000/api
# NEXT_PUBLIC_FARM_SOCKET_URL=http://localhost:4000   (defaults to the farm API's origin)

# Used by server components (native fetch). Falls back to NEXT_PUBLIC_API_URL.
API_URL=http://localhost:8000/api

# Absolute URLs in the sitemap / Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
