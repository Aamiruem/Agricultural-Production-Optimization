# Dev-server proxy targets (vite.config.js). Defaults match `python main.py` at the repo root.
API_PROXY_TARGET=http://127.0.0.1:8000
FARM_PROXY_TARGET=http://127.0.0.1:4100
MCP_PROXY_TARGET=http://127.0.0.1:8100

# Production build: leave empty to call the APIs on the same origin (the gateway
# serves the dashboard on :8090 and proxies /api, /farm-api and /mcp).
VITE_API_BASE=
