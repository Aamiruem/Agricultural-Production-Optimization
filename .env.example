# Used by docker-compose.yml. Copy to .env and fill in.

# Shared by the FastAPI and Node services (they verify each other's tokens).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

POSTGRES_PASSWORD=agri

# Optional: enables the Claude-powered assistant (otherwise knowledge-base answers only)
ANTHROPIC_API_KEY=

# Optional: field photo uploads to S3
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
